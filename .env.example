PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

NODE_ENV=development
# Defaults to true in development, false in test/production
# SWAGGER_ENABLED=true

POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgres://nebuli:replace-with-local-password@127.0.0.1:15432/nebuli
DATABASE_SSL=false

# Must match NUXT_AUTH_PROXY_SECRET in the Nuxt server environment
AUTH_PROXY_SECRET=
# Separate database for integration tests
TEST_DATABASE_URL=postgres://nebuli:replace-with-local-password@127.0.0.1:15432/nebuli_test

# Required exact HTTPS frontend origins in production
DICE_WS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3100
DICE_WS_HANDSHAKES_PER_MIN=30
